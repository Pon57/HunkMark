{
  "manifest_version": 3,
  "name": "HunkMark – Diff Review for GitHub",
  "short_name": "HunkMark",
  "version": "3.0.0",
  "description": "Review GitHub pull request diffs by hunk or line, collapse reviewed changes, and track progress.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "core.js",
        "content/app.js",
        "content/discovery.js",
        "content/review-context.js",
        "content/review-storage.js",
        "content/official-viewed.js",
        "content/controllers.js",
        "content/sticky-hunk-base.js",
        "content/sticky-hunk-geometry.js",
        "content/sticky-hunk-navigation.js",
        "content/sticky-hunk-layout.js",
        "content/sticky-hunks.js",
        "content/context-expansion-controls.js",
        "content/context-expansion-evidence.js",
        "content/context-expansion-baselines.js",
        "content/context-expansion-state.js",
        "content/context-expansion-intents.js",
        "content/drag.js",
        "content/panel.js",
        "content/review-reconciliation.js",
        "content/refresh.js",
        "content/lifecycle.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
